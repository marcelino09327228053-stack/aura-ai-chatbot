# Aura environment variables (copy to .env)

SECRET_KEY=change-this-in-production
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional AI providers. A provider is enabled only when its key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
XAI_API_KEY=
XAI_MODEL=grok-4.3
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Managed AI Gateway. Provider order also defines authorized fallback order.
AI_GATEWAY_PROVIDER_ORDER=gemini,openai,claude,groq
AI_GATEWAY_MAX_RETRIES=1
AI_GATEWAY_GLOBAL_CONCURRENCY=20
AI_GATEWAY_CUSTOMER_CONCURRENCY=2
AI_GATEWAY_QUEUE_LIMIT=200
AI_GATEWAY_CUSTOMER_QUEUE_LIMIT=10
AI_GATEWAY_QUEUE_TIMEOUT_SECONDS=30
AI_GATEWAY_RETRY_BASE_SECONDS=0.5
AI_GATEWAY_RETRY_MAX_SECONDS=15
AI_GATEWAY_RETRY_JITTER_SECONDS=0.25
AI_GATEWAY_PROVIDER_COOLDOWN_SECONDS=30
AI_GATEWAY_DISTRIBUTED_LEASE_SECONDS=120
AI_GATEWAY_QUEUE_POLL_SECONDS=0.05
# Minor units are centavos. The test plan is PHP 1,500/month with a PHP 500
# maximum monthly AI usage allowance (not a provider invoice).
AI_PLAN_CONFIG_JSON={"free":{"price_minor":0,"monthly_ai_allowance_minor":0,"currency":"PHP","max_companies":1},"test":{"price_minor":150000,"monthly_ai_allowance_minor":50000,"currency":"PHP","max_companies":5}}
# Exchange rate used only to translate calculated USD provider cost into the
# allowance's PHP centavos. Configure this operationally.
AI_GATEWAY_USD_TO_ALLOWANCE_RATE=58.0
# Per-model provider pricing is required before a model can charge allowance.
AI_MODEL_COSTS_USD_JSON={}
# Mock payments are automatically disabled when AURA_ENV=production.
MOCK_PAYMENTS_ENABLED=true

# Facebook Page Messenger integration (BYO Meta Page/App credentials)
FACEBOOK_APP_ID=
FACEBOOK_VERIFY_TOKEN=replace-with-a-long-random-verify-token
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_COMPANY_ID=1
FACEBOOK_AI_PROVIDERS=gemini
FACEBOOK_LANGUAGE=auto
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_OAUTH_REDIRECT_URI=
JWT_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_HOURS=1
LEGACY_COMPANY_ID=1
AURA_ENV=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Passwordless email login (SMTP)
# Local development shows the code on the login screen when SMTP is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
# Optional: disable business modules
# MODULE_CRM_ENABLED=true
# MODULE_INVENTORY_ENABLED=true
# MODULE_ACCOUNTING_ENABLED=true
# MODULE_HR_ENABLED=true
# MODULE_REPORTS_ENABLED=true
# MODULE_ANALYTICS_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

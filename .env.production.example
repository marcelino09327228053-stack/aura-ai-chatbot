# Production profile
AURA_ENV=production
DB_BACKEND=postgres
DATABASE_URL=postgresql://aura:aura@database:5432/aura
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
AGENTS_ENABLED=true
PLUGINS_ENABLED=true
SECRET_KEY=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_PROVIDER=your-payment-provider
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
REFERRAL_PRICING_DEFAULTS_JSON={"monthly_platform_price_minor":100000,"initial_ai_credit_minor":50000,"minimum_ai_topup_minor":50000,"referral_commission_minor":30000,"ai_usage_markup_bps":0,"currency":"PHP"}
AI_METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
ALLOWED_HOSTS=chatbot.example.com
CORS_ALLOWED_ORIGINS=https://chatbot.example.com
FORCE_HTTPS=true
GEMINI_API_KEY=
OWNER_CONSOLE_SECRET=replace-with-at-least-32-random-characters
OWNER_PASSWORD_HASH=generate-with-scripts-setup-owner-console
OWNER_TOTP_SECRET=generate-with-scripts-setup-owner-console
OWNER_ALLOWED_NETWORKS=127.0.0.0/8,172.16.0.0/12,100.64.0.0/10
OWNER_COOKIE_SECURE=true
CLOUD_ENCRYPTION_KEY=generate-with-scripts-setup-owner-console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/auth/google/callback

# Production profile
AURA_ENV=production
DB_BACKEND=postgres
DATABASE_URL=postgresql://aura:aura@database:5432/aura
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
AGENTS_ENABLED=true
PLUGINS_ENABLED=true
SECRET_KEY=production-secret-must-be-strong-and-random
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/auth/google/callback
